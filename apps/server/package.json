{
  "name": "@chess/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --target node22 --clean --out-dir dist",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chess/config": "workspace:*",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  }
}

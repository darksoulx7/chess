# Server (apps/server). Copy to apps/server/.env for local dev.
NODE_ENV=development
STOCKFISH_PATH=/usr/games/stockfish
PORT=4000
# Access-token signing key (>= 32 chars). The dev default is rejected in production.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
DATABASE_URL=postgres://chess:chess@127.0.0.1:5432/chess
REDIS_URL=redis://127.0.0.1:6379
# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Client (apps/client). Public, baked at build time.
EXPO_PUBLIC_API_URL=http://localhost:4000
